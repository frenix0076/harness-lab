{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessRunEvent",
  "type": "object",
  "required": ["event_id", "timestamp", "run_id", "ticket", "event", "status"],
  "properties": {
    "event_id": {"type": "string"},
    "run_id": {"type": "string"},
    "parent_span_id": {"type": ["string", "null"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "ticket": {"type": "string"},
    "event": {"type": "string"},
    "status": {"type": "string"},
    "actor_identity": {"type": ["string", "null"]},
    "agent_id": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "operation": {"type": ["string", "null"]},
    "target": {"type": ["string", "null"]},
    "tool": {"type": ["string", "null"]},
    "tools": {"type": ["array", "null"], "items": {"type": "string"}},
    "input_digest": {"type": ["string", "null"]},
    "policy_decision": {"type": ["string", "null"]},
    "approval_id": {"type": ["string", "null"]},
    "evidence_refs": {"type": ["array", "null"], "items": {"type": "string"}},
    "context_refs": {"type": ["array", "null"], "items": {"type": "string"}},
    "git_ref": {"type": ["string", "null"]},
    "git_sha": {"type": ["string", "null"]},
    "turns": {"type": ["integer", "null"]},
    "retries": {"type": ["integer", "null"]},
    "verification_failures": {"type": ["integer", "null"]},
    "human_corrections": {"type": ["integer", "null"]},
    "input_tokens": {"type": ["integer", "null"]},
    "output_tokens": {"type": ["integer", "null"]},
    "cost": {"type": ["number", "null"]},
    "duration_ms": {"type": ["integer", "null"]},
    "verifier": {"type": ["string", "null"]},
    "result": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
